import { Theme } from "../theme.slint";
import { Icons, FaIcon } from "../icons.slint";

/// Shell-wide cut/copy/paste/select-all for the focused TextInput.
/// `action`: 1 cut, 2 copy, 3 paste, 4 select-all. Bump `token` to deliver.
export global TextEditActions {
    in-out property <int> token: 0;
    in-out property <int> action: 0;
}

// role: "primary" | "secondary" | "danger"
// Content-sized pill — hug the label; do not stretch to fill the parent.
export component Button inherits TouchArea {
    in property <string> label;
    in property <string> role: "secondary";
    in property <bool> square: false;
    in property <bool> active: true;
    callback activate;

    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: Theme.touch-min;
    min-width: square ? Theme.touch-min : 0px;
    opacity: active ? 1.0 : 0.45;
    enabled: active;

    HorizontalLayout {
        padding-left: square ? 0px : 4px;
        padding-right: square ? 0px : 4px;
        padding-top: square ? 0px : 6px;
        padding-bottom: square ? 0px : 6px;

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-width: root.square ? Theme.touch-min : (label.preferred-width + 32px);
            min-height: root.square ? Theme.touch-min : 36px;
            background: root.pressed && root.active
                ? (root.role == "primary" ? Theme.accent-press
                    : root.role == "danger" ? Theme.danger-press
                    : Theme.surface-press)
                : (root.role == "primary" ? Theme.accent
                    : root.role == "danger" ? Theme.danger
                    : Theme.surface-2);
            border-radius: square ? Theme.radius : 999px;
            border-width: root.role == "secondary" ? 1px : 0;
            border-color: Theme.surface-press;

            label := Text {
                font-family: Theme.font-family;
                text: root.label;
                color: root.role == "secondary" ? Theme.text : Theme.text-on-accent;
                font-size: Theme.font-body;
                font-weight: 600;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    clicked => { if root.active { root.activate(); } }
}

export component IconButton inherits TouchArea {
    /// Font Awesome glyph from `Icons.*`. Leave empty when using `icon`.
    in property <string> glyph: "";
    /// Optional monochrome image (e.g. outline gear); used when `glyph` is empty.
    in property <image> icon;
    in property <bool> active: true;
    callback activate;

    min-height: Theme.touch-min;
    min-width: Theme.touch-min;
    opacity: active ? 1.0 : 0.45;
    enabled: active;

    Rectangle {
        background: root.pressed && root.active ? Theme.surface-press : transparent;
        border-radius: Theme.radius;
        if root.glyph != "": FaIcon {
            glyph: root.glyph;
            size: 22px;
            tone: Theme.text;
            width: 100%;
            height: 100%;
        }
        if root.glyph == "": Image {
            source: root.icon;
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: Theme.text;
            image-fit: contain;
        }
    }

    clicked => { if root.active { root.activate(); } }
}

/// Pill-shaped action button (matches ViewPill chrome).
export component PillButton inherits TouchArea {
    in property <string> label: "";
    callback activate;

    min-height: Theme.touch-min;
    horizontal-stretch: 0;
    label-size := Text {
        font-family: Theme.font-family;
        text: root.label;
        font-size: Theme.font-body;
        font-weight: 600;
        opacity: 0;
        width: 0px;
        height: 0px;
        accessible-role: none;
    }
    // Wide enough for the label inside the pill inset and side padding.
    property <length> pill-width: max(96px, label-size.preferred-width + 44px);
    min-width: root.pill-width;
    max-width: root.pill-width;
    preferred-width: root.pill-width;

    // Visual pill inset from the touch target / header chrome.
    Rectangle {
        x: 4px;
        y: 6px;
        width: parent.width - 8px;
        height: parent.height - 12px;
        border-radius: self.height / 2;
        background: root.pressed ? Theme.surface-press : Theme.surface-2;
        border-width: 1px;
        border-color: Theme.surface-press;
        Text {
            font-family: Theme.font-family;
            x: 14px;
            y: 0;
            width: parent.width - 28px;
            height: 100%;
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    clicked => { root.activate(); }
}

/// Floating pill dropdown for preset view selection (Day / Week / Month / Year).
export component ViewPill inherits TouchArea {
    in property <string> label: "";
    in property <int> selected: 0;
    in property <[string]> options;
    callback changed(int);

    min-height: Theme.touch-min;
    min-width: Theme.preset-pill-width;
    max-width: Theme.preset-pill-width;
    preferred-width: Theme.preset-pill-width;

    // Visual pill inset from the touch target / header chrome.
    Rectangle {
        x: 4px;
        y: 6px;
        width: parent.width - 8px;
        height: parent.height - 12px;
        border-radius: (parent.height - 12px) / 2;
        background: root.pressed ? Theme.surface-press : Theme.surface-2;
        border-width: 1px;
        border-color: Theme.surface-press;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            spacing: 10px;
            alignment: center;
            Text {
                font-family: Theme.font-family;
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            FaIcon {
                glyph: Icons.chevron-down;
                size: 12px;
                tone: Theme.muted;
            }
        }
    }

    clicked => { menu.show(); }

    menu := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: max(root.width, 168px);
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.surface-2;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for opt[i] in root.options: TouchArea {
                    min-height: Theme.touch-min;
                    clicked => {
                        root.changed(i);
                        menu.close();
                    }
                    Rectangle {
                        background: parent.pressed ? Theme.surface-press
                            : (i == root.selected ? Theme.accent : transparent);
                        border-radius: 14px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                font-family: Theme.font-family;
                                text: opt;
                                color: i == root.selected ? Theme.text-on-accent : Theme.text;
                                font-size: Theme.font-body;
                                font-weight: i == root.selected ? 600 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                height: 100%;
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Touch-friendly ⓘ tip — tap to show help (PopupWindow).
export component InfoTip inherits TouchArea {
    in property <string> text: "";

    width: Theme.touch-min;
    height: Theme.touch-min;

    FaIcon {
        glyph: Icons.circle-info;
        size: 18px;
        tone: parent.pressed ? Theme.accent : Theme.muted;
        width: 100%;
        height: 100%;
    }

    clicked => { if root.text != "" { tip.show(); } }

    tip := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 300px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.surface-2;
            VerticalLayout {
                padding: Theme.pad-sm;
                Text {
                    font-family: Theme.font-family;
                    text: root.text;
                    color: Theme.text;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                    width: parent.width - 2 * Theme.pad-sm;
                }
            }
        }
    }
}

export component Field inherits VerticalLayout {
    in property <string> caption;
    in property <string> tip: "";
    in-out property <string> text;
    callback edited();
    spacing: 4px;

    property <int> edit-token: TextEditActions.token;
    changed edit-token => {
        if field-input.has-focus {
            if TextEditActions.action == 1 { field-input.cut(); }
            if TextEditActions.action == 2 { field-input.copy(); }
            if TextEditActions.action == 3 { field-input.paste(); }
            if TextEditActions.action == 4 { field-input.select-all(); }
        }
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: stretch;
        cross-axis-alignment: center;
        Text {
            font-family: Theme.font-family;
            text: root.caption;
            color: Theme.muted;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
        }
        if tip != "": InfoTip { text: root.tip; }
    }
    Rectangle {
        min-height: Theme.touch-min;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: field-input.has-focus ? 2px : 0;
        border-color: Theme.accent;
        // TextInput only takes clicks on its own box. The layout used to size that
        // box to the glyphs, so the rest of the field did nothing.
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { field-input.focus(); }
        }
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.pad-sm;
            alignment: stretch;
            field-input := TextInput {
                font-family: Theme.font-family;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.font-body;
                single-line: true;
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                edited => { root.edited(); }
            }
        }
    }
}

export component LongField inherits VerticalLayout {
    in property <string> caption;
    in-out property <string> text;
    callback edited();
    spacing: 4px;

    property <int> edit-token: TextEditActions.token;
    changed edit-token => {
        if field-input.has-focus {
            if TextEditActions.action == 1 { field-input.cut(); }
            if TextEditActions.action == 2 { field-input.copy(); }
            if TextEditActions.action == 3 { field-input.paste(); }
            if TextEditActions.action == 4 { field-input.select-all(); }
        }
    }

    Text {
        font-family: Theme.font-family;
        text: root.caption;
        color: Theme.muted;
        font-size: Theme.font-caption;
    }
    Rectangle {
        min-height: 96px;
        vertical-stretch: 1;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: field-input.has-focus ? 2px : 0;
        border-color: Theme.accent;
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { field-input.focus(); }
        }
        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.pad-sm;
            alignment: stretch;
            field-input := TextInput {
                font-family: Theme.font-family;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.font-body;
                single-line: false;
                wrap: word-wrap;
                horizontal-alignment: left;
                vertical-alignment: top;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                edited => { root.edited(); }
            }
        }
    }
}

// mark: "" | "check" | "color"
export component Row inherits TouchArea {
    in property <string> title;
    in property <string> caption: "";
    in property <string> mark: "";
    in property <bool> checked: false;
    in property <color> mark-color: Theme.accent;
    callback activate;

    min-height: Theme.touch-min;

    Rectangle {
        background: root.pressed ? Theme.surface-press : Theme.surface;
        border-radius: Theme.radius;
        HorizontalLayout {
            padding: Theme.pad;
            spacing: Theme.pad;
            alignment: stretch;
            cross-axis-alignment: center;
            if mark == "check": Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius;
                border-width: 2px;
                border-color: Theme.accent;
                background: root.checked ? Theme.accent : transparent;
                if root.checked: FaIcon {
                    glyph: Icons.check;
                    size: 14px;
                    tone: Theme.text-on-accent;
                    width: 100%;
                    height: 100%;
                }
            }
            if mark == "color": Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius;
                background: root.mark-color;
            }
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                horizontal-stretch: 1;
                Text {
                    font-family: Theme.font-family;
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    horizontal-alignment: left;
                }
                if caption != "": Text {
                    font-family: Theme.font-family;
                    text: root.caption;
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
            }
        }
    }

    clicked => { root.activate(); }
}

// kind: 0 idle/muted, 1 ok, 2 accent, 3 danger
export component Banner inherits Rectangle {
    in property <string> message: "";
    in property <int> kind: 0;
    visible: message != "";
    height: message == "" ? 0px : self.preferred-height;
    HorizontalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        Text {
            font-family: Theme.font-family;
            text: root.message;
            color: root.kind == 1 ? Theme.ok
                : root.kind == 2 ? Theme.accent
                : root.kind == 3 ? Theme.danger
                : Theme.muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
            horizontal-stretch: 1;
            horizontal-alignment: left;
        }
    }
}

/// Label and info on the left, the control on the right, empty space between.
/// `alignment: stretch` is required: center/start ignore `horizontal-stretch`.
export component SettingRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> tip: "";

    spacing: 4px;
    alignment: stretch;
    cross-axis-alignment: center;
    min-height: Theme.touch-min;
    min-width: 0px;
    horizontal-stretch: 1;

    if root.label != "": Text {
        font-family: Theme.font-family;
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: left;
        min-width: 0px;
        overflow: elide;
    }
    if root.tip != "": InfoTip { text: root.tip; }
    Rectangle { horizontal-stretch: 1; }
    @children
}

/// Hairline between settings rows — inset so it doesn’t meet section edges.
export component SettingsDivider inherits HorizontalLayout {
    padding-left: Theme.pad;
    padding-right: Theme.pad;
    height: 1px;
    vertical-stretch: 0;

    Rectangle {
        height: 1px;
        horizontal-stretch: 1;
        background: Theme.stroke;
    }
}

/// Right-aligned text box. Wider than a switch or a two-digit count.
/// The touch row stays full height; the box is inset like a settings dropdown.
export component ShortInput inherits Rectangle {
    in-out property <string> text: "";
    in property <length> box-width: 220px;
    in property <int> font-weight: 400;
    callback edited();

    // Preferred size is the designed box. Shrinks so the row stays inside the panel.
    min-width: 96px;
    max-width: root.box-width;
    preferred-width: root.box-width;
    min-height: Theme.touch-min;
    vertical-stretch: 0;
    background: transparent;

    property <int> edit-token: TextEditActions.token;
    changed edit-token => {
        if input.has-focus {
            if TextEditActions.action == 1 { input.cut(); }
            if TextEditActions.action == 2 { input.copy(); }
            if TextEditActions.action == 3 { input.paste(); }
            if TextEditActions.action == 4 { input.select-all(); }
        }
    }

    Rectangle {
        x: 2px;
        y: 8px;
        width: parent.width - 4px;
        height: parent.height - 16px;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.surface-2;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { input.focus(); }
        }
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: Theme.pad-sm;
            padding-right: Theme.pad-sm;
            alignment: stretch;
            input := TextInput {
                font-family: Theme.font-family;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: root.font-weight;
                single-line: true;
                horizontal-alignment: left;
                vertical-alignment: center;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                edited => { root.edited(); }
            }
        }
    }
}

export component Switch inherits HorizontalLayout {
    in-out property <bool> checked: false;
    in property <string> label: "";
    in property <string> tip: "";
    callback toggled;

    spacing: Theme.pad;
    alignment: stretch;
    cross-axis-alignment: center;
    min-height: Theme.touch-min;

    if label != "": Text {
        font-family: Theme.font-family;
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: left;
        horizontal-stretch: 1;
    }
    if tip != "": InfoTip { text: root.tip; }
    TouchArea {
        width: 56px;
        height: Theme.touch-min;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 56px;
            height: 32px;
            border-radius: 16px;
            background: parent.pressed
                ? (root.checked ? Theme.accent-press : Theme.surface-press)
                : (root.checked ? Theme.accent : Theme.surface-2);
            animate background { duration: 120ms; }
            Rectangle {
                x: root.checked ? parent.width - self.width - 4px : 4px;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: Theme.text-on-accent;
                animate x { duration: 120ms; }
            }
        }
    }
}

export component Dropdown inherits VerticalLayout {
    in property <string> caption: "";
    in property <string> tip: "";
    in property <[string]> options;
    /// When set, each menu row is drawn in this face (same length as `options`). Empty string = system font.
    in property <[string]> option-fonts;
    in-out property <int> selected: 0;
    /// Caption, info, and the selector share one row. The selector sits on the right.
    in property <bool> inline: false;
    /// Selector is only as wide as a two-digit count.
    in property <bool> compact: false;
    callback changed(int);

    spacing: 4px;
    horizontal-stretch: 1;
    property <string> current: root.selected >= 0 && root.selected < root.options.length
        ? root.options[root.selected] : "";
    property <length> menu-height: min(root.options.length * (Theme.touch-min + 2px) + 8px, 320px);

    if !root.inline && (root.caption != "" || root.tip != ""): HorizontalLayout {
        spacing: 4px;
        alignment: stretch;
        cross-axis-alignment: center;
        if root.caption != "": Text {
            font-family: Theme.font-family;
            text: root.caption;
            color: Theme.muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
        if root.tip != "": InfoTip { text: root.tip; }
        Rectangle { horizontal-stretch: 1; }
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: stretch;
        cross-axis-alignment: center;
        if root.inline && root.caption != "": Text {
            font-family: Theme.font-family;
            text: root.caption;
            color: Theme.muted;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
        if root.inline && root.tip != "": InfoTip { text: root.tip; }
        if root.inline: Rectangle { horizontal-stretch: 1; }

        ta := TouchArea {
            min-height: Theme.touch-min;
            horizontal-stretch: root.inline ? 0 : 1;
            min-width: root.compact ? 72px : 96px;
            preferred-width: root.compact ? 72px : 220px;
            max-width: root.compact ? 72px : 280px;
            clicked => {
                if menu.is-open { menu.close(); } else { menu.show(); }
            }
            Rectangle {
                x: 2px;
                y: 8px;
                width: parent.width - 4px;
                height: parent.height - 16px;
                background: ta.pressed ? Theme.surface-press : Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.surface-2;
                HorizontalLayout {
                    height: 100%;
                    padding-left: Theme.pad-sm;
                    padding-right: Theme.pad-sm;
                    spacing: 4px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Text {
                        font-family: Theme.font-family;
                        text: root.current;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: root.compact ? center : left;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    FaIcon {
                        glyph: menu.is-open ? Icons.chevron-up : Icons.chevron-down;
                        size: 12px;
                        tone: Theme.muted;
                    }
                }
            }

            // Same pattern as ViewPill: the list is the popup's content, so it has a real height.
            menu := PopupWindow {
                x: ta.width - self.width;
                y: ta.height + 4px;
                width: max(ta.width, root.compact ? 72px : 220px);
                height: root.menu-height;
                close-policy: close-on-click-outside;

                Rectangle {
                    height: root.menu-height;
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.surface-2;
                    clip: true;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        content-width: self.width;
                        content-height: options-list.preferred-height;

                        options-list := VerticalLayout {
                            padding: 4px;
                            spacing: 2px;
                            width: parent.width;
                            for opt[i] in options: TouchArea {
                                min-height: Theme.touch-min;
                                clicked => {
                                    // Read the index before close. Closing the popup first
                                    // drops the repeater index and the choice comes back as 6.
                                    root.changed(i);
                                    menu.close();
                                }
                                Rectangle {
                                    background: parent.pressed ? Theme.surface-press
                                        : (i == root.selected ? Theme.accent : transparent);
                                    border-radius: Theme.radius;
                                    HorizontalLayout {
                                        padding-left: Theme.pad-sm;
                                        padding-right: Theme.pad-sm;
                                        Text {
                                            text: opt;
                                            font-family: i < root.option-fonts.length ? root.option-fonts[i] : Theme.font-family;
                                            color: i == root.selected ? Theme.text-on-accent : Theme.text;
                                            font-size: Theme.font-body;
                                            vertical-alignment: center;
                                            horizontal-alignment: root.compact ? center : left;
                                            horizontal-stretch: 1;
                                            height: 100%;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Long-press / hover tip. Pure Slint state — no Rust round-trip.
export component Tip inherits Rectangle {
    in property <string> text: "";
    in-out property <bool> show: false;
    min-height: Theme.touch-min;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.show = !root.show; }
        moved => {
            if ta.has-hover { root.show = true; }
        }
        @children
    }

    if show && text != "": Rectangle {
        y: parent.height + 4px;
        z: 20;
        background: Theme.surface-2;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.surface;
        HorizontalLayout {
            padding: 6px;
            Text {
                font-family: Theme.font-family;
                text: root.text;
                color: Theme.text;
                font-size: Theme.font-caption;
            }
        }
    }
}

/// Color box. Click opens a hue/saturation/value field (Paint-style). Drag to pick; release commits.
export component ColorBox inherits TouchArea {
    in property <color> value: #3b82f6;
    callback picked(string);

    property <bool> dragging: false;
    property <float> drag-h: 0;
    property <float> drag-s: 1;
    property <float> drag-v: 1;
    property <float> hue: root.dragging ? root.drag-h : root.value.to-hsv().hue;
    property <float> sat: root.dragging ? root.drag-s : root.value.to-hsv().saturation;
    property <float> val: root.dragging ? root.drag-v : root.value.to-hsv().value;
    // Parents read this in `picked` while the drag is still active, then bind it
    // back to `value`. Without that, the thumb jumps to the old color on release.
    out property <color> shown: hsv(root.hue, root.sat, root.val);

    function hex-digit(n: int) -> string {
        n <= 0 ? "0" : n == 1 ? "1" : n == 2 ? "2" : n == 3 ? "3" : n == 4 ? "4"
            : n == 5 ? "5" : n == 6 ? "6" : n == 7 ? "7" : n == 8 ? "8" : n == 9 ? "9"
            : n == 10 ? "a" : n == 11 ? "b" : n == 12 ? "c" : n == 13 ? "d"
            : n == 14 ? "e" : "f";
    }
    function hex-byte(n: int) -> string {
        root.hex-digit(floor(n / 16)) + root.hex-digit(mod(n, 16));
    }
    function hex-of(c: color) -> string {
        "#" + root.hex-byte(c.red) + root.hex-byte(c.green) + root.hex-byte(c.blue);
    }
    function begin-drag() {
        if !root.dragging {
            root.drag-h = root.value.to-hsv().hue;
            root.drag-s = root.value.to-hsv().saturation;
            root.drag-v = root.value.to-hsv().value;
            root.dragging = true;
        }
    }
    function commit() {
        root.picked(root.hex-of(root.shown));
        root.dragging = false;
    }

    // Bar is three times the old 36px square, still tall enough to tap.
    property <length> chip: 36px;
    min-width: root.chip * 3;
    preferred-width: root.chip * 3;
    max-width: root.chip * 3;
    min-height: Theme.touch-min;
    horizontal-stretch: 0;

    Rectangle {
        width: root.chip * 3;
        height: root.chip;
        border-radius: 6px;
        background: root.shown;
        border-width: 2px;
        border-color: menu.is-open ? Theme.text : Theme.surface-press;
        x: 0;
        y: (parent.height - self.height) / 2;
    }

    clicked => { if menu.is-open { menu.close(); } else { menu.show(); } }

    menu := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.surface-2;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                // Saturation across, value down. White→hue, then a black fade.
                sv := TouchArea {
                    width: 220px;
                    height: 180px;
                    changed mouse-x => {
                        if self.pressed {
                            root.begin-drag();
                            root.drag-s = clamp(self.mouse-x / self.width, 0, 1);
                            root.drag-v = clamp(1 - self.mouse-y / self.height, 0, 1);
                        }
                    }
                    changed mouse-y => {
                        if self.pressed {
                            root.begin-drag();
                            root.drag-s = clamp(self.mouse-x / self.width, 0, 1);
                            root.drag-v = clamp(1 - self.mouse-y / self.height, 0, 1);
                        }
                    }
                    changed pressed => {
                        if self.pressed {
                            root.begin-drag();
                            root.drag-s = clamp(self.mouse-x / self.width, 0, 1);
                            root.drag-v = clamp(1 - self.mouse-y / self.height, 0, 1);
                        } else if root.dragging {
                            root.commit();
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-width: 1px;
                        border-color: Theme.surface-press;
                        background: @linear-gradient(90deg, #ffffff 0%, hsv(root.hue, 1, 1) 100%);
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
                        }
                    }
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: root.val > 0.6 ? #000000 : #ffffff;
                        background: transparent;
                        x: root.sat * (parent.width - self.width);
                        y: (1 - root.val) * (parent.height - self.height);
                    }
                }

                hue-bar := TouchArea {
                    width: 36px;
                    height: 180px;
                    changed mouse-y => {
                        if self.pressed {
                            root.begin-drag();
                            root.drag-h = clamp(self.mouse-y / self.height, 0, 1) * 360;
                        }
                    }
                    changed pressed => {
                        if self.pressed {
                            root.begin-drag();
                            root.drag-h = clamp(self.mouse-y / self.height, 0, 1) * 360;
                        } else if root.dragging {
                            root.commit();
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-width: 1px;
                        border-color: Theme.surface-press;
                        background: @linear-gradient(180deg,
                            hsv(0, 1, 1) 0%, hsv(60, 1, 1) 16%, hsv(120, 1, 1) 33%,
                            hsv(180, 1, 1) 50%, hsv(240, 1, 1) 66%, hsv(300, 1, 1) 83%,
                            hsv(360, 1, 1) 100%);
                    }
                    Rectangle {
                        x: 0;
                        y: (root.hue / 360) * (parent.height - self.height);
                        width: 100%;
                        height: 6px;
                        border-width: 2px;
                        border-color: #ffffff;
                        background: #000000;
                    }
                }
            }
        }
    }
}
