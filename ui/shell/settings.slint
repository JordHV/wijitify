import { Theme } from "../theme.slint";
import { NavButton } from "./nav.slint";

export struct ModuleToggleRow {
    id: string,
    name: string,
    description: string,
    enabled: bool,
}

export component SettingsView inherits Rectangle {
    background: Theme.bg;

    in property <[ModuleToggleRow]> modules;
    in property <string> perf-overlay: "";

    // Updates: 0 unsupported, 1 up-to-date, 2 available, 3 installing, 4 ready, 5 failed
    in property <string> current-version: "";
    in property <int> update-status: 0;
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <int> update-percent: 0;
    in property <string> update-error: "";
    in property <string> update-checked: "";

    callback toggle-module(int);
    callback run-setup-again();
    callback quit-app();
    callback close-settings();
    callback check-updates();
    callback start-update();
    callback restart-app();

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.pad;

        HorizontalLayout {
            Text {
                text: "Settings";
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            NavButton { label: "Close"; activate => { root.close-settings(); } }
        }

        Text { text: "Modules"; color: Theme.muted; font-size: 14px; }

        for m[i] in modules: ta := TouchArea {
            min-height: Theme.touch-min;
            clicked => { root.toggle-module(i); }
            Rectangle {
                background: ta.pressed ? Theme.surface-2 : Theme.surface;
                border-radius: 10px;
                HorizontalLayout {
                    padding: Theme.pad;
                    spacing: Theme.pad;
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 6px;
                        border-width: 2px; border-color: Theme.accent;
                        background: m.enabled ? Theme.accent : transparent;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: m.name; color: Theme.text; font-size: 18px; }
                        Text { text: m.description; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    }
                }
            }
        }

        if update-status != 0: VerticalLayout {
            spacing: Theme.pad-sm;
            Text { text: "Updates"; color: Theme.muted; font-size: 14px; }
            Rectangle {
                background: Theme.surface;
                border-radius: 10px;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: Theme.pad-sm;

                    Text {
                        text: "Wijitify " + root.current-version;
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    if update-status == 1: Text {
                        text: root.update-checked == "" ? "Up to date" : "Up to date · checked " + root.update-checked;
                        color: Theme.muted;
                        font-size: 14px;
                    }
                    if update-status == 2: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Update available: v" + root.update-version;
                            color: Theme.ok;
                            font-size: 16px;
                            font-weight: 600;
                        }
                        if update-notes != "": Text {
                            text: root.update-notes;
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                    if update-status == 3: Text {
                        text: "Installing… " + root.update-percent + "%";
                        color: Theme.accent;
                        font-size: 16px;
                    }
                    if update-status == 4: Text {
                        text: "Update installed — restart to use it";
                        color: Theme.ok;
                        font-size: 16px;
                    }
                    if update-status == 5: Text {
                        text: root.update-error;
                        color: Theme.danger;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        if update-status == 1 || update-status == 5: NavButton {
                            label: update-status == 5 ? "Retry" : "Check now";
                            activate => { root.check-updates(); }
                        }
                        if update-status == 2: NavButton {
                            label: "Update";
                            activate => { root.start-update(); }
                        }
                        if update-status == 4: NavButton {
                            label: "Restart now";
                            activate => { root.restart-app(); }
                        }
                    }
                }
            }
        }

        NavButton { label: "Run setup again"; activate => { root.run-setup-again(); } }
        NavButton { label: "Quit to desktop"; activate => { root.quit-app(); } }

        if perf-overlay != "": Text {
            text: root.perf-overlay;
            color: Theme.ok;
            font-size: 12px;
            font-family: "monospace";
        }
    }
}
