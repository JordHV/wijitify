import { Theme } from "../../theme.slint";
import { Icons, FaIcon, EventIcon } from "../../icons.slint";
import {
    Button, IconButton, PillButton, ViewPill, Field, LongField, Switch, Dropdown, ColorBox, TextEditActions
} from "../../shell/kit.slint";

/// Timed: surface fill + color bar. All-day: solid event color.
/// No `clip`: femtovg renders rounded clips to an unaligned texture, blurring text at fractional grid positions.
component EventChip inherits Rectangle {
    in property <string> title: "";
    in property <string> time-text: "";
    in property <color> event-color: Theme.accent;
    in property <bool> all-day: false;
    in property <bool> show-time: false;
    in property <bool> compact: false;
    /// Title wraps up to this many lines, then the last line ends with ….
    in property <int> title-lines: 1;

    property <int> lines: clamp(root.title-lines, 1, 10);
    property <bool> multi: root.lines > 1;

    background: root.all-day ? root.event-color : Theme.surface-2;
    border-radius: root.compact ? 3px : 4px;

    line-probe := Text {
        font-family: Theme.font-family;
        width: 0px;
        height: 0px;
        opacity: 0;
        accessible-role: none;
        text: "Ag";
        font-size: root.compact ? Theme.font-event-compact : Theme.font-event;
        font-weight: 600;
    }
    property <length> title-block: line-probe.preferred-height * root.lines;
    property <length> time-size: root.compact ? Theme.font-event-time-compact : Theme.font-event-time;
    min-height: root.title-block + (root.show-time && root.time-text != "" ? root.time-size + 2px : 0px) + 4px;

    HorizontalLayout {
        width: 100%;
        spacing: 0;
        if !root.all-day: Rectangle {
            width: Theme.event-bar;
            background: root.event-color;
            border-top-left-radius: root.border-radius;
            border-bottom-left-radius: root.border-radius;
            vertical-stretch: 1;
        }
        VerticalLayout {
            padding-left: root.compact ? 4px : 6px;
            padding-right: root.compact ? 4px : 6px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 0px;
            alignment: start;
            Text {
                font-family: Theme.font-family;
                text: root.title;
                color: root.all-day ? Theme.text-on-accent : Theme.text;
                font-size: root.compact ? Theme.font-event-compact : Theme.font-event;
                font-weight: root.all-day || !root.compact ? 600 : 500;
                wrap: root.multi ? word-wrap : no-wrap;
                overflow: elide;
                max-lines: root.lines;
                min-width: 0px;
                horizontal-stretch: 1;
                vertical-alignment: top;
                min-height: root.title-block;
            }
            if root.show-time && root.time-text != "": Text {
                font-family: Theme.font-family;
                text: root.time-text;
                color: root.all-day ? Theme.text-on-accent : Theme.muted;
                font-size: root.time-size;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

/// Calendar visibility toggle: colored square + check when on, name centered inline.
component FeedCheckRow inherits TouchArea {
    in property <string> name: "";
    in property <color> swatch: Theme.accent;
    in property <bool> checked: true;
    callback toggled;

    height: 36px;
    vertical-stretch: 0;
    clicked => { root.toggled(); }

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            vertical-stretch: 0;
            border-radius: 3px;
            border-width: 2px;
            border-color: root.swatch;
            background: root.checked ? root.swatch : transparent;
            if root.checked: FaIcon {
                glyph: Icons.check;
                size: 11px;
                tone: Theme.text-on-accent;
                width: 100%;
                height: 100%;
            }
        }
        Text {
            font-family: Theme.font-family;
            text: root.name;
            color: Theme.text;
            font-size: Theme.font-caption;
            height: 18px;
            vertical-alignment: center;
            horizontal-alignment: left;
            horizontal-stretch: 1;
            vertical-stretch: 0;
            opacity: root.checked ? 1.0 : 0.5;
        }
    }
}

export struct EventRow {
    uid: string,
    recurrence-id: string,
    feed-id: string,
    /// ISO date yyyy-mm-dd for day/week grid placement.
    date-key: string,
    time: string,
    /// Compact 12h range for chips (independent of day-modal show-time).
    time-short: string,
    title: string,
    calendar: string,
    description: string,
    location: string,
    color: color,
    icon: string,
    writable: bool,
    all-day: bool,
    /// Minutes from midnight for timed events; -1 when all-day.
    start-mins: int,
    /// 0-based index among that day's events (all-day first, then timed).
    day-ord: int,
    /// 0-based index within the timed hour-slot bucket; all-day uses all-day order.
    slot-ord: int,
    /// Size of the slot/all-day bucket this row belongs to (for +N more).
    slot-total: int,
}

export struct DayCell {
    day: int,
    in-month: bool,
    is-today: bool,
    is-past: bool,
    is-weekend: bool,
    has-events: bool,
    /// Total events that day (for +N more after fitting chips).
    event-count: int,
    /// All-day subset count (day/week all-day row overflow).
    all-day-count: int,
    /// Matches selected_day (light highlight when not today).
    is-selected: bool,
    /// In the selected week while week view is active.
    in-selected-week: bool,
    label: string,
    event-color: color,
    /// ISO date yyyy-mm-dd for selection callbacks (empty when padding).
    date-key: string,
    /// This day's chip rows (main day/week/month/agenda grids only; empty elsewhere).
    events: [EventRow],
}

export struct FeedChip {
    id: string,
    name: string,
    color: color,
    visible: bool,
    writable: bool,
    /// Writable calendar new events are created on. At most one feed is true.
    is-default: bool,
}

/// Day-modal hour bucket (label + events starting in that slot).
export struct DayHourBucket {
    label: string,
    start-mins: int,
    end-mins: int,
}

export struct CustomFieldRow {
    id: string,
    name: string,
    /// 0 short text, 1 long text, 2 yes/no, 3 choice
    field-type: int,
    value: string,
    option-count: int,
    /// Choice list includes an empty option.
    has-blank: bool,
}

export struct ChoiceOption {
    field-id: string,
    label: string,
}

/// Full-width choice list. Options for every choice field share one model.
component ChoiceDropdown inherits VerticalLayout {
    in property <string> value: "";
    in property <string> field-id: "";
    in property <int> option-count: 0;
    in property <bool> has-blank: false;
    in property <[ChoiceOption]> options;
    // id, value. The id is a copy taken on open — the field repeater index is
    // wrong if it is read from inside a popup or after the model refreshes.
    callback picked(string, string);

    spacing: 2px;
    horizontal-stretch: 1;
    min-width: 0px;

    property <bool> open: false;
    // Plain copy of field-id. Assignment drops the binding so a later model
    // refresh cannot retarget the choice onto another field.
    property <string> id-snap: "";
    property <string> shown: root.value != "" ? root.value : (root.has-blank ? "(blank)" : "Choose");

    changed field-id => { root.id-snap = root.field-id; }

    ta := TouchArea {
        height: Theme.touch-min;
        horizontal-stretch: 1;
        min-width: 0px;
        clicked => {
            root.id-snap = root.field-id;
            if root.option-count > 0 {
                root.open = !root.open;
            }
        }
        Rectangle {
            y: 8px;
            width: parent.width;
            height: parent.height - 16px;
            background: ta.pressed ? Theme.surface-press : Theme.surface-2;
            border-radius: Theme.radius;
            HorizontalLayout {
                height: 100%;
                padding-left: Theme.pad-sm;
                padding-right: Theme.pad-sm;
                spacing: 4px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    font-family: Theme.font-family;
                    text: root.shown;
                    color: root.value == "" && !root.has-blank ? Theme.muted : Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                FaIcon {
                    glyph: root.open ? Icons.chevron-up : Icons.chevron-down;
                    size: 12px;
                    tone: Theme.muted;
                }
            }
        }
    }

    if root.open: VerticalLayout {
        spacing: 2px;
        width: 100%;
        min-width: 0px;
        for opt[i] in root.options: opt-row := TouchArea {
            property <string> label: opt.label;
            visible: opt.field-id == root.id-snap;
            height: Theme.touch-min;
            min-width: 0px;
            clicked => {
                root.picked(root.id-snap, root.options[i].label);
                root.open = false;
            }
            Rectangle {
                y: 1px;
                height: Theme.touch-min - 2px;
                width: 100%;
                background: opt-row.pressed ? Theme.surface-press
                    : (opt-row.label == root.value ? Theme.accent : Theme.surface-2);
                border-radius: Theme.radius;
                HorizontalLayout {
                    padding-left: Theme.pad-sm;
                    padding-right: Theme.pad-sm;
                    alignment: center;
                    Text {
                        font-family: Theme.font-family;
                        text: opt-row.label == "" ? "(blank)" : opt-row.label;
                        color: opt-row.label == root.value ? Theme.text-on-accent : Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        height: 100%;
                    }
                }
            }
        }
    }
}

component MiniMonth inherits VerticalLayout {
    in property <string> title: "";
    in property <[string]> week-labels;
    in property <[DayCell]> days;
    in property <int> offset: 0;
    in property <int> columns: 7;
    callback select-date(string);

    spacing: 2px;

    Text {
        font-family: Theme.font-family;
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-caption;
        font-weight: 600;
        horizontal-alignment: center;
    }
    // Fixed equal cells — event dots are overlaid and never change column/row size.
    GridLayout {
        spacing: 1px;
        Row {
            for w in week-labels: Text {
                font-family: Theme.font-family;
                text: w;
                color: Theme.muted;
                font-size: 10px * Theme.font-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                min-width: 0px;
                preferred-width: 0px;
                height: 16px;
                horizontal-stretch: 1;
            }
        }
        for row in 6: Row {
            for col in root.columns: ta := TouchArea {
                property <DayCell> d: days[root.offset + row * root.columns + col];
                min-width: 0px;
                preferred-width: 0px;
                height: 28px;
                horizontal-stretch: 1;
                clicked => {
                    if d.date-key != "" { root.select-date(d.date-key); }
                }
                Rectangle {
                    clip: true;
                    background: ta.pressed ? Theme.surface-press
                        : ((ta.d.is-selected || ta.d.in-selected-week) && !ta.d.is-today
                            ? Theme.selection-fill : transparent);
                    border-radius: 3px;
                    // Filled today circle (accent); selection uses light fill above when not today
                    if ta.d.is-today: Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 - 1px;
                    }
                    Text {
                        font-family: Theme.font-family;
                        text: ta.d.label;
                        color: ta.d.is-today ? Theme.text-on-accent : Theme.text;
                        font-size: 11px * Theme.font-scale;
                        font-weight: ta.d.is-today || ta.d.is-selected ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    if ta.d.has-events && !ta.d.is-today: Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.muted;
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 2px;
                    }
                }
            }
        }
    }
}

component MonthGrid inherits Rectangle {
    in property <[string]> week-labels;
    in property <[DayCell]> days;
    in property <int> offset: 0;
    in property <int> columns: 7;
    in property <int> rows: 6;
    in property <int> title-lines: 1;
    in property <bool> shade-weekends: true;
    callback select-date(string);

    vertical-stretch: 1;
    horizontal-stretch: 1;
    clip: true;
    background: Theme.bg;

    line-probe := Text {
        font-family: Theme.font-family;
        width: 0px;
        height: 0px;
        opacity: 0;
        accessible-role: none;
        text: "Ag";
        font-size: Theme.font-event-compact;
        font-weight: 600;
    }
    property <length> chip-h: line-probe.preferred-height * clamp(root.title-lines, 1, 10) + 4px;
    property <length> chip-stride: root.chip-h + 2px;

    // Header and week rows share stretch so columns stay equal without a GridLayout repeater.
    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding: 0px;

        HorizontalLayout {
            height: 28px;
            vertical-stretch: 0;
            for w in week-labels: Text {
                font-family: Theme.font-family;
                text: w;
                color: Theme.muted;
                font-size: Theme.font-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                min-width: 0px;
                preferred-width: 0px;
                min-height: 28px;
                max-height: 28px;
                horizontal-stretch: 1;
            }
        }
        for row in root.rows: HorizontalLayout {
            vertical-stretch: 1;
            for col in root.columns: ta := TouchArea {
                property <DayCell> d: days[root.offset + row * root.columns + col];
                // 16px chip + 2px gap below the 27px label row; one slot is kept for "+N more" on overflow.
                property <int> max-slots: max(0, floor((self.height - 27px) / root.chip-stride));
                property <int> chip-limit: ta.d.event-count > ta.max-slots
                    ? max(0, ta.max-slots - 1)
                    : ta.d.event-count;
                min-width: 0px;
                preferred-width: 0px;
                preferred-height: 0px;
                min-height: 48px;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clicked => {
                    if d.date-key != "" { root.select-date(d.date-key); }
                }
                Rectangle {
                    clip: true;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    background: ta.pressed ? Theme.surface-press
                        : ((ta.d.is-selected || ta.d.in-selected-week) && !ta.d.is-today
                            ? Theme.selection-fill
                            : (root.shade-weekends && ta.d.is-weekend ? Theme.weekend-fill : Theme.bg));
                    // Today accent ring
                    if ta.d.is-today: Rectangle {
                        border-width: 2px;
                        border-color: Theme.accent;
                        border-radius: 2px;
                        background: transparent;
                        width: parent.width - 2px;
                        height: parent.height - 2px;
                        x: 1px;
                        y: 1px;
                    }
                    VerticalLayout {
                        padding: 3px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            if ta.d.is-today: Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.accent;
                                Text {
                                    font-family: Theme.font-family;
                                    // Day number only — label may include month abbr for other-month cells.
                                    text: ta.d.day;
                                    color: Theme.text-on-accent;
                                    font-size: Theme.font-caption;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                            if !ta.d.is-today: Text {
                                font-family: Theme.font-family;
                                text: ta.d.label;
                                color: Theme.text;
                                font-size: Theme.font-caption;
                                font-weight: 600;
                            }
                        }
                    }
                    // Explicit x/y keeps chips out of the cell's layout size, which `max-slots` reads back.
                    for e in ta.d.events: EventChip {
                        x: 3px;
                        y: 27px + e.day-ord * root.chip-stride;
                        width: parent.width - 6px;
                        height: root.chip-h;
                        visible: e.day-ord < ta.chip-limit;
                        title: e.title;
                        title-lines: root.title-lines;
                        event-color: e.color;
                        all-day: e.all-day;
                        compact: true;
                    }
                    Text {
                        font-family: Theme.font-family;
                        x: 5px;
                        y: 27px + ta.chip-limit * root.chip-stride;
                        width: parent.width - 10px;
                        height: root.chip-h;
                        visible: ta.d.event-count > ta.chip-limit;
                        text: "+" + (ta.d.event-count - ta.chip-limit) + " more";
                        color: Theme.muted;
                        font-size: 10px * Theme.font-scale;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export struct RepeatWeekday {
    letter: string,
    index: int,
    on: bool,
}

/// One event in the month/year day popup. Height follows the text, at least a touch target.
component DayModalRow inherits Rectangle {
    in property <string> title: "";
    in property <string> time: "";
    in property <string> calendar: "";
    in property <color> event-color: Theme.accent;
    in property <string> icon: "";
    callback clicked();

    height: max(Theme.touch-min, body.preferred-height);
    horizontal-stretch: 1;
    background: area.pressed ? Theme.surface-press : Theme.surface-2;
    border-radius: Theme.radius;

    body := HorizontalLayout {
        padding: Theme.pad-sm;
        spacing: Theme.pad-sm;
        Rectangle {
            width: 6px;
            vertical-stretch: 1;
            background: root.event-color;
            border-radius: 3px;
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;
            if root.time != "": Text {
                font-family: Theme.font-family;
                text: root.time;
                color: Theme.muted;
                font-size: Theme.font-caption;
                wrap: word-wrap;
                width: 100%;
            }
            Text {
                font-family: Theme.font-family;
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
                width: 100%;
            }
            if root.calendar != "": Text {
                font-family: Theme.font-family;
                text: root.calendar;
                color: Theme.muted;
                font-size: Theme.font-caption;
                wrap: word-wrap;
                width: 100%;
            }
        }
        if root.icon != "": EventIcon {
            id: root.icon;
            size: Theme.font-body;
            tone: root.event-color;
        }
    }
    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component DayDot inherits TouchArea {
    in property <string> letter;
    in property <bool> on;
    width: Theme.touch-min;
    height: Theme.touch-min;
    Rectangle {
        width: 40px;
        height: 40px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        background: root.on ? Theme.accent : Theme.surface-2;
        border-width: root.on ? 0px : 2px;
        border-color: Theme.muted;
        Text {
            font-family: Theme.font-family;
            text: root.letter;
            color: root.on ? Theme.text-on-accent : Theme.text;
            font-size: Theme.font-body;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
}

/// Caption, value, and ±. The value elides so the row cannot force a horizontal scroll.
component Stepper inherits HorizontalLayout {
    in property <string> caption;
    in property <string> value;
    callback dec();
    callback inc();

    spacing: Theme.pad-sm;
    alignment: stretch;
    cross-axis-alignment: center;
    min-width: 0px;

    Text {
        font-family: Theme.font-family;
        text: root.caption;
        color: Theme.muted;
        font-size: Theme.font-caption;
        vertical-alignment: center;
        horizontal-stretch: 0;
    }
    Text {
        font-family: Theme.font-family;
        text: root.value;
        color: Theme.text;
        font-size: Theme.font-body;
        horizontal-stretch: 1;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        min-width: 0px;
    }
    Button {
        label: "−";
        role: "secondary";
        square: true;
        activate => { root.dec(); }
    }
    Button {
        label: "+";
        role: "secondary";
        square: true;
        activate => { root.inc(); }
    }
}

component ChoiceRow inherits TouchArea {
    in property <string> label;
    in property <bool> selected;
    min-height: Theme.touch-min;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        cross-axis-alignment: center;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            border-width: 2px;
            border-color: root.selected ? Theme.accent : Theme.muted;
            background: transparent;
            if root.selected: Rectangle {
                width: 12px;
                height: 12px;
                x: 5px;
                y: 5px;
                border-radius: 6px;
                background: Theme.accent;
            }
        }
        Text {
            font-family: Theme.font-family;
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
}

export component ZalenderView inherits Rectangle {
    // Chrome (top + side) shares this surface; the active view uses Theme.bg.
    background: Theme.surface;

    in property <string> clock-text: "";
    in property <string> title-period: "";
    in property <string> status-text: "";
    in property <int> status-kind: 0;
    in property <bool> refreshing: false;
    in property <bool> empty-feeds: false;

    /// 0 day, 1 week, 2 month, 3 year, 4 agenda
    in property <int> view-unit: 2;
    in property <[string]> preset-options;
    in property <int> preset-selected: 0;
    in property <string> preset-label: "Month";
    in property <int> view-count: 1;

    in property <[string]> week-labels;
    /// Month/year header labels after hidden weekdays are removed.
    in property <[string]> grid-labels;
    in property <int> grid-columns: 7;
    /// Week rows in the month grid (from the preset week count).
    in property <int> month-rows: 6;
    /// Event title lines before ellipsis. The chip grows with this.
    in property <int> title-lines: 1;
    /// Most all-day events on any day in the current day/week view.
    in property <int> all-day-rows: 0;
    in property <string> side-title: "";
    in property <[DayCell]> side-days;
    in property <[DayCell]> main-days;
    in property <[string]> year-month-titles;
    in property <[FeedChip]> feeds;
    /// Timed-grid hour slots from the active preset (uniform step).
    in property <[DayHourBucket]> hour-slots;
    property <int> grid-start: hour-slots.length > 0 ? hour-slots[0].start-mins : 0;
    property <int> grid-end: hour-slots.length > 0 ? hour-slots[hour-slots.length - 1].end-mins : 0;
    property <int> grid-step: hour-slots.length > 0 ? max(1, hour-slots[0].end-mins - hour-slots[0].start-mins) : 60;
    // Per 48px hour row: one chip with time, else two compact chips.
    property <int> timed-max: show-event-time ? 1 : 2;
    timed-probe := Text {
        font-family: Theme.font-family;
        width: 0px;
        height: 0px;
        opacity: 0;
        accessible-role: none;
        text: "Ag";
        font-size: root.show-event-time ? Theme.font-event : Theme.font-event-compact;
        font-weight: 600;
    }
    property <length> timed-chip-h: timed-probe.preferred-height * clamp(root.title-lines, 1, 10)
        + (root.show-event-time ? Theme.font-event-time + 4px : 4px);
    // Same metrics as an all-day EventChip so the band matches the chips.
    all-day-probe := Text {
        font-family: Theme.font-family;
        width: 0px;
        height: 0px;
        opacity: 0;
        accessible-role: none;
        text: "Ag";
        font-size: root.show-event-time ? Theme.font-event : Theme.font-event-compact;
        font-weight: 600;
    }
    property <length> all-day-chip-h: all-day-probe.preferred-height * clamp(root.title-lines, 1, 10) + 4px;
    // 2px padding each side, 2px between chips. Empty when nothing is all-day.
    property <length> all-day-band-h: root.all-day-rows <= 0 ? 0px
        : 4px + root.all-day-chip-h * root.all-day-rows + 2px * max(0, root.all-day-rows - 1);
    /// Minutes from midnight for the now-lollipop.
    in property <int> now-mins: 0;
    /// Title + time on chips (day / week·1 / agenda).
    in property <bool> show-event-time: false;
    in property <bool> dim-past: true;
    in property <bool> shade-weekends: true;

    in property <bool> day-modal-open: false;
    in property <string> day-modal-title: "";
    in property <string> selected-date-key: "";
    in property <[EventRow]> day-events;
    // events_on sorts all-day first, then timed by start.
    property <bool> modal-has-all-day: day-events.length > 0 && day-events[0].all-day;
    property <bool> modal-has-timed: day-events.length > 0 && !day-events[day-events.length - 1].all-day;

    in property <bool> name-local-open: false;
    in-out property <string> name-local-draft: "";

    in property <bool> create-event-open: false;
    in-out property <string> create-title: "";
    in property <string> create-date-key: "";
    in property <string> create-date-label: "";
    in property <int> create-start-mins: 540;
    in property <int> create-end-mins: 600;
    in property <bool> create-all-day: false;
    in property <string> create-calendar-name: "Local calendar";
    in property <string> create-start-label: "";
    in property <string> create-end-label: "";
    in-out property <string> create-location: "";
    in-out property <string> create-description: "";
    in property <bool> create-repeat: false;
    in property <bool> create-repeat-open: false;
    in property <string> create-repeat-summary: "";
    in property <int> create-repeat-interval: 1;
    in property <int> create-repeat-unit: 0;
    in property <[string]> create-repeat-units;
    in property <int> create-repeat-end: 0;
    in property <string> create-until-label: "";
    in property <int> create-repeat-count: 10;
    in property <[RepeatWeekday]> create-weekdays;
    in property <bool> create-by-weekday: false;
    in property <string> create-month-dom-label: "";
    in property <string> create-month-nth-label: "";
    in property <string> create-quarter-dom-label: "";
    in property <string> create-quarter-nth-label: "";

    in property <bool> event-detail-open: false;
    in property <EventRow> detail-event;
    in property <string> detail-custom-summary: "";

    in property <bool> customize-open: false;
    in property <color> customize-color: #3b82f6;
    in property <string> customize-icon: "";
    in property <bool> customize-occurrence: false;
    in property <bool> customize-has-recurrence: false;
    in property <[CustomFieldRow]> customize-fields;
    in property <[ChoiceOption]> customize-choices;
    // Line box for the customize editors. Long text is three of these.
    field-line := Text {
        font-family: Theme.font-family;
        width: 0px;
        height: 0px;
        opacity: 0;
        accessible-role: none;
        text: "Ag";
        font-size: Theme.font-body;
    }
    property <length> line-h: max(field-line.preferred-height, Theme.font-body);

    in property <bool> edit-placeholder-open: false;
    /// Settings (or another shell overlay) already dims the calendar.
    in property <bool> hide-scrim: false;
    property <bool> sheet-open: root.day-modal-open || root.event-detail-open
        || root.create-event-open || root.create-repeat-open || root.customize-open
        || root.edit-placeholder-open || root.name-local-open;
    // Just under the front sheet so earlier scrims are not stacked.
    property <int> sheet-scrim-z: root.create-repeat-open ? 84
        : root.name-local-open ? 89
        : root.edit-placeholder-open ? 79
        : (root.customize-open || root.create-event-open) ? 69
        : root.event-detail-open ? 59
        : 49;

    callback prev-period();
    callback next-period();
    callback zoom-out();
    callback go-today();
    callback go-preset();
    callback select-preset(int);
    callback open-settings();
    callback refresh();
    callback select-date(string);
    /// Left sidebar mini-month: jump to day view for that date (no modal).
    callback select-side-date(string);
    callback toggle-feed(int);
    callback set-default-feed(int);
    callback close-day-modal();
    callback open-create-event(string, int, bool);
    callback close-create-event();
    callback create-set-title(string);
    callback create-set-location(string);
    callback create-set-description(string);
    callback create-shift-date(int);
    callback create-open-repeat();
    callback create-close-repeat();
    callback create-clear-repeat();
    callback create-set-repeat-interval(int);
    callback create-set-repeat-unit(int);
    callback create-set-repeat-end(int);
    callback create-shift-until(int);
    callback create-set-repeat-count(int);
    callback create-toggle-weekday(int);
    callback create-set-by-weekday(bool);
    callback create-set-all-day(bool);
    callback create-set-start-mins(int);
    callback create-set-end-mins(int);
    callback create-save();
    callback name-local-set(string);
    callback name-local-save();
    callback open-event(int);
    callback open-event-uid(string, string);
    callback close-event-detail();
    callback open-customize();
    callback open-edit();
    callback close-customize();
    callback close-edit-placeholder();
    callback customize-set-color(string);
    callback customize-set-icon(string);
    callback customize-set-occurrence(bool);
    callback customize-set-field(string, string);
    callback customize-save();

    /// Left mini-month + calendar list; toggled from the gear row.
    property <bool> sidebar-open: true;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Top chrome: Gear · collapse | Today · <> · Month Year …… preset · Default · Refresh
        // Logo assets kept under assets/zalender-logo-*.png for possible future use.
        Rectangle {
            min-height: Theme.touch-min + 8px;
            max-height: Theme.touch-min + 8px;
            background: Theme.surface;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-right: Theme.pad-sm;
                spacing: 0;
                alignment: stretch;
                cross-axis-alignment: center;

                // When open, match sidebar width; when closed, shrink to the icon cluster.
                HorizontalLayout {
                    min-width: root.sidebar-open ? 260px : Theme.touch-min * 2 + Theme.pad-sm * 2;
                    max-width: root.sidebar-open ? 260px : Theme.touch-min * 2 + Theme.pad-sm * 2;
                    preferred-width: root.sidebar-open ? 260px : Theme.touch-min * 2 + Theme.pad-sm * 2;
                    padding-left: Theme.pad-sm;
                    padding-right: Theme.pad-sm;
                    spacing: Theme.pad-sm;
                    alignment: start;
                    cross-axis-alignment: center;
                    IconButton {
                        icon: Icons.gear-hollow;
                        activate => { root.open-settings(); }
                    }
                    IconButton {
                        icon: root.sidebar-open ? Icons.panel-left-fill : Icons.panel-left;
                        activate => { root.sidebar-open = !root.sidebar-open; }
                    }
                    if root.sidebar-open: Rectangle { horizontal-stretch: 1; }
                }

                if root.sidebar-open: Rectangle {
                    width: 1px;
                    height: 28px;
                    background: Theme.stroke;
                }

                // Over the calendar view (not the sidebar)
                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-left: Theme.pad-sm;
                    spacing: Theme.pad-sm;
                    alignment: start;
                    cross-axis-alignment: center;

                    PillButton {
                        label: "Today";
                        activate => { root.go-today(); }
                    }
                    IconButton {
                        glyph: Icons.chevron-left;
                        activate => { root.prev-period(); }
                    }
                    IconButton {
                        glyph: Icons.chevron-right;
                        activate => { root.next-period(); }
                    }
                    TouchArea {
                        clicked => { root.zoom-out(); }
                        Text {
                            font-family: Theme.font-family;
                            text: root.title-period;
                            color: Theme.text;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ViewPill {
                        selected: root.preset-selected;
                        label: root.preset-label;
                        options: root.preset-options;
                        changed(i) => { root.select-preset(i); }
                    }
                    PillButton {
                        label: "Default";
                        activate => { root.go-preset(); }
                    }
                    IconButton {
                        glyph: Icons.refresh;
                        activate => { root.refresh(); }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.stroke;
            horizontal-stretch: 1;
        }

        if empty-feeds: Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.pad;
                alignment: center;
                Text {
                    font-family: Theme.font-family;
                    text: "No calendars yet";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    horizontal-alignment: center;
                }
                Text {
                    font-family: Theme.font-family;
                    text: "Add an ICS feed in Settings or run setup again.";
                    color: Theme.muted;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Button {
                    label: "Open settings";
                    role: "secondary";
                    activate => { root.open-settings(); }
                }
            }
        }

        if !empty-feeds: HorizontalLayout {
            spacing: 0;
            vertical-stretch: 1;

            // Left chrome sidebar (same surface as top bar)
            if root.sidebar-open: Rectangle {
                min-width: 260px;
                max-width: 260px;
                background: Theme.surface;
                VerticalLayout {
                width: 100%;
                height: 100%;
                padding: Theme.pad-sm;
                spacing: Theme.pad-sm;

                    MiniMonth {
                        title: root.side-title;
                        week-labels: root.week-labels;
                        days: root.side-days;
                        offset: 0;
                        select-date(k) => { root.select-side-date(k); }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.stroke;
                        horizontal-stretch: 1;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        content-width: parent.width - 2 * Theme.pad-sm;
                        VerticalLayout {
                            width: parent.width;
                            spacing: Theme.pad-sm;
                            alignment: start;

                            Text {
                                font-family: Theme.font-family;
                                text: "Editable calendars";
                                color: Theme.muted;
                                font-size: Theme.font-caption;
                                font-weight: 600;
                            }
                            for f[i] in feeds: VerticalLayout {
                                if f.writable: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    cross-axis-alignment: center;
                                    FeedCheckRow {
                                        horizontal-stretch: 1;
                                        name: f.name;
                                        swatch: f.color;
                                        checked: f.visible;
                                        toggled => { root.toggle-feed(i); }
                                    }
                                    TouchArea {
                                        min-width: 84px;
                                        height: 36px;
                                        clicked => { root.set-default-feed(i); }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: end;
                                            cross-axis-alignment: center;
                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                vertical-stretch: 0;
                                                border-radius: 3px;
                                                border-width: 2px;
                                                border-color: f.is-default ? Theme.accent : Theme.muted;
                                                background: f.is-default ? Theme.accent : transparent;
                                                if f.is-default: FaIcon {
                                                    glyph: Icons.check;
                                                    size: 11px;
                                                    tone: Theme.text-on-accent;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                            }
                                            Text {
                                                font-family: Theme.font-family;
                                                text: "Default";
                                                color: f.is-default ? Theme.text : Theme.muted;
                                                font-size: Theme.font-caption;
                                                height: 18px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    font-family: Theme.font-family;
                                    text: "ICS calendars";
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                IconButton {
                                    glyph: Icons.plus;
                                    activate => { root.open-settings(); }
                                }
                            }
                            for f[i] in feeds: VerticalLayout {
                                if !f.writable: FeedCheckRow {
                                    name: f.name;
                                    swatch: f.color;
                                    checked: f.visible;
                                    toggled => { root.toggle-feed(i); }
                                }
                            }
                        }
                    }

                }
            }
            if root.sidebar-open: Rectangle {
                width: 1px;
                background: Theme.stroke;
                vertical-stretch: 1;
            }

            // Active view — own background, inset from chrome
            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                padding-top: Theme.pad-sm;
                padding-right: Theme.pad-sm;
                padding-bottom: Theme.pad-sm;
                padding-left: root.sidebar-open ? 0 : Theme.pad-sm;

                Rectangle {
                    background: Theme.bg;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    clip: true;

                // Day / week — frozen day header + all-day; only the hour grid scrolls
                if view-unit == 0 || view-unit == 1: VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 0px;
                    padding: 4px;

                    // Frozen day headers — 56px axis | 8px gap | equal day columns
                    HorizontalLayout {
                        spacing: 0px;
                        width: 100%;
                        min-height: root.view-unit == 0 ? 64px : 52px;
                        max-height: root.view-unit == 0 ? 64px : 52px;
                        vertical-stretch: 0;
                        Rectangle {
                            min-width: 56px;
                            max-width: 56px;
                            preferred-width: 56px;
                        }
                        Rectangle {
                            min-width: Theme.pad-sm;
                            max-width: Theme.pad-sm;
                            preferred-width: Theme.pad-sm;
                        }
                        HorizontalLayout {
                            spacing: root.view-unit == 1 ? 3px : 0px;
                            horizontal-stretch: 1;
                            for cell[d] in main-days: TouchArea {
                                // preferred-width 0 + equal stretch — must match all-day / hour columns.
                                min-width: 0px;
                                preferred-width: 0px;
                                horizontal-stretch: 1;
                                clicked => {
                                    if cell.date-key != "" { root.select-date(cell.date-key); }
                                }
                                Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    border-radius: 4px;
                                    background: parent.pressed ? Theme.surface-press : transparent;
                                    VerticalLayout {
                                        width: 100%;
                                        height: 100%;
                                        spacing: 2px;
                                        alignment: center;
                                        // Weekday above day number — both centered in the column.
                                        Text {
                                            font-family: Theme.font-family;
                                            text: cell.label;
                                            color: cell.is-today ? Theme.accent : Theme.muted;
                                            font-size: root.view-unit == 1 ? 11px * Theme.font-scale : Theme.font-caption;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            width: 100%;
                                            overflow: elide;
                                        }
                                        // Same-sized badge every column so stretch widths match all-day/hours.
                                        if root.view-unit == 0 || root.view-unit == 1: HorizontalLayout {
                                            width: 100%;
                                            alignment: center;
                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 16px;
                                                background: cell.is-today ? Theme.accent
                                                    : (cell.is-selected ? Theme.selection-fill : transparent);
                                                Text {
                                                    font-family: Theme.font-family;
                                                    text: cell.day;
                                                    color: cell.is-today ? Theme.text-on-accent : Theme.text;
                                                    font-size: Theme.font-body;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // As tall as the busiest day's all-day events. Other days leave empty space below theirs.
                    if root.all-day-rows > 0: HorizontalLayout {
                        spacing: 0px;
                        width: 100%;
                        min-height: root.all-day-band-h;
                        max-height: root.all-day-band-h;
                        vertical-stretch: 0;
                        Text {
                            font-family: Theme.font-family;
                            text: "All day";
                            color: Theme.muted;
                            font-size: 11px * Theme.font-scale;
                            min-width: 56px;
                            max-width: 56px;
                            preferred-width: 56px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        Rectangle {
                            min-width: Theme.pad-sm;
                            max-width: Theme.pad-sm;
                            preferred-width: Theme.pad-sm;
                        }
                        HorizontalLayout {
                            spacing: root.view-unit == 1 ? 3px : 0px;
                            horizontal-stretch: 1;
                            vertical-stretch: 0;
                            for cell[d] in main-days: Rectangle {
                                min-width: 0px;
                                preferred-width: 0px;
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                height: 100%;
                                clip: true;
                                background: root.shade-weekends && cell.is-weekend ? Theme.weekend-fill : Theme.bg;
                                border-width: 1px;
                                border-color: Theme.stroke;
                                TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        if cell.date-key != "" {
                                            root.open-create-event(cell.date-key, 0, true);
                                        }
                                    }
                                    Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: parent.pressed ? Theme.surface-press : transparent;
                                    }
                                }
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    alignment: start;
                                    for e in cell.events: VerticalLayout {
                                        spacing: 0px;
                                        if e.all-day: TouchArea {
                                            min-width: 0px;
                                            preferred-width: 0px;
                                            horizontal-stretch: 1;
                                            clicked => { root.open-event-uid(cell.date-key, e.uid); }
                                            EventChip {
                                                title: e.title;
                                                title-lines: root.title-lines;
                                                time-text: "";
                                                event-color: e.color;
                                                all-day: true;
                                                show-time: false;
                                                compact: !root.show-event-time;
                                                min-width: 0px;
                                                preferred-width: 0px;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Scrollable hour grid — takes all remaining height
                    Flickable {
                        vertical-stretch: 1;
                        min-height: 120px;
                        content-width <=> self.width;
                        HorizontalLayout {
                            spacing: 0px;
                            width: 100%;
                            min-height: root.hour-slots.length * 48px;

                            VerticalLayout {
                                min-width: 56px;
                                max-width: 56px;
                                preferred-width: 56px;
                                spacing: 0px;
                                for slot in root.hour-slots: Rectangle {
                                    height: 48px;
                                    Text {
                                        font-family: Theme.font-family;
                                        text: slot.label;
                                        color: Theme.muted;
                                        font-size: 10px * Theme.font-scale;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: right;
                                        vertical-alignment: top;
                                    }
                                    Rectangle {
                                        y: 0;
                                        width: 100%;
                                        height: 1px;
                                        background: Theme.surface-press;
                                    }
                                }
                            }
                            Rectangle {
                                min-width: Theme.pad-sm;
                                max-width: Theme.pad-sm;
                                preferred-width: Theme.pad-sm;
                            }
                            HorizontalLayout {
                                spacing: root.view-unit == 1 ? 3px : 0px;
                                horizontal-stretch: 1;
                                for cell[d] in main-days: Rectangle {
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    horizontal-stretch: 1;
                                    min-height: root.hour-slots.length * 48px;
                                    clip: true;
                                    background: root.shade-weekends && cell.is-weekend ? Theme.weekend-fill : Theme.bg;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    VerticalLayout {
                                        width: 100%;
                                        spacing: 0px;
                                        for slot in root.hour-slots: TouchArea {
                                            height: 48px;
                                            clicked => {
                                                if cell.date-key != "" {
                                                    root.open-create-event(cell.date-key, slot.start-mins, false);
                                                }
                                            }
                                            Rectangle {
                                                background: parent.pressed ? Theme.surface-press : transparent;
                                                Rectangle {
                                                    y: 0;
                                                    width: 100%;
                                                    height: 1px;
                                                    background: Theme.stroke;
                                                }
                                            }
                                        }
                                    }
                                    // One pass over this day's events, placed by hour slot (above the slot TouchAreas).
                                    for e in cell.events: TouchArea {
                                        property <bool> in-grid: !e.all-day
                                            && e.start-mins >= root.grid-start && e.start-mins < root.grid-end;
                                        property <int> limit: e.slot-total > root.timed-max
                                            ? max(0, root.timed-max - 1) : e.slot-total;
                                        visible: in-grid && e.slot-ord < limit;
                                        x: 2px;
                                        y: floor((e.start-mins - root.grid-start) / root.grid-step) * 48px
                                            + 2px + e.slot-ord * (root.timed-chip-h + 2px);
                                        width: parent.width - 4px;
                                        height: root.timed-chip-h;
                                        clicked => { root.open-event-uid(cell.date-key, e.uid); }
                                        EventChip {
                                            title: e.title;
                                            title-lines: root.title-lines;
                                            time-text: e.time-short;
                                            event-color: e.color;
                                            show-time: root.show-event-time;
                                            compact: !root.show-event-time;
                                        }
                                    }
                                    for e in cell.events: Text {
                                        font-family: Theme.font-family;
                                        visible: !e.all-day && e.slot-ord == 0 && e.slot-total > root.timed-max
                                            && e.start-mins >= root.grid-start && e.start-mins < root.grid-end;
                                        x: 6px;
                                        y: floor((e.start-mins - root.grid-start) / root.grid-step) * 48px
                                            + 2px + (root.timed-max - 1) * (root.timed-chip-h + 2px);
                                        width: parent.width - 8px;
                                        height: 16px;
                                        text: "+" + (e.slot-total - max(0, root.timed-max - 1)) + " more";
                                        color: Theme.muted;
                                        font-size: 10px * Theme.font-scale;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                    // Danger-red now-lollipop on today's column
                                    if cell.is-today && root.hour-slots.length > 0
                                        && root.now-mins >= root.hour-slots[0].start-mins
                                        && root.now-mins <= root.hour-slots[root.hour-slots.length - 1].end-mins: Rectangle {
                                        property <int> slot-span: root.hour-slots[0].end-mins - root.hour-slots[0].start-mins;
                                        property <length> y-pos: slot-span > 0
                                            ? (root.now-mins - root.hour-slots[0].start-mins) * 48px / slot-span
                                            : 0px;
                                        y: y-pos - 5px;
                                        height: 10px;
                                        width: 100%;
                                        background: transparent;
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: Theme.danger;
                                            x: 0;
                                            y: 0;
                                        }
                                        Rectangle {
                                            x: 5px;
                                            y: 4px;
                                            width: parent.width - 5px;
                                            height: 2px;
                                            background: Theme.danger;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Month view — fixed equal columns under Sun–Sat header
                if view-unit == 2: VerticalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: Theme.pad-sm;
                    padding: 0;
                    for m in view-count: MonthGrid {
                        week-labels: root.grid-labels;
                        days: root.main-days;
                        columns: root.grid-columns;
                        rows: root.month-rows;
                        title-lines: root.title-lines;
                        offset: m * root.month-rows * root.grid-columns;
                        shade-weekends: root.shade-weekends;
                        vertical-stretch: 1;
                        select-date(k) => { root.select-date(k); }
                    }
                }

                // Year view
                if view-unit == 3: Flickable {
                    width: 100%;
                    height: 100%;
                    content-width: parent.width;
                    VerticalLayout {
                        spacing: Theme.pad;
                        padding: Theme.pad-sm;
                        for y in view-count: VerticalLayout {
                            spacing: Theme.pad-sm;
                            for row in 4: HorizontalLayout {
                                spacing: Theme.pad-sm;
                                for col in 3: MiniMonth {
                                    property <int> mi: y * 12 + row * 3 + col;
                                    title: mi < root.year-month-titles.length
                                        ? root.year-month-titles[mi] : "";
                                    week-labels: root.grid-labels;
                                    days: root.main-days;
                                    columns: root.grid-columns;
                                    offset: mi * 6 * root.grid-columns;
                                    horizontal-stretch: 1;
                                    select-date(k) => { root.select-date(k); }
                                }
                            }
                        }
                    }
                }

                // Agenda — chronological list grouped by day (main-days already filtered to event days)
                if view-unit == 4: Flickable {
                    width: 100%;
                    height: 100%;
                    content-width: parent.width;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.pad;
                        alignment: start;
                        for cell in main-days: VerticalLayout {
                            spacing: Theme.pad-sm;
                            HorizontalLayout {
                                spacing: Theme.pad-sm;
                                cross-axis-alignment: center;
                                Text {
                                    font-family: Theme.font-family;
                                    text: cell.label;
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                }
                                if cell.is-today: Text {
                                    font-family: Theme.font-family;
                                    text: "Today";
                                    color: Theme.accent;
                                    font-size: Theme.font-caption;
                                    font-weight: 600;
                                }
                            }
                            for e in cell.events: TouchArea {
                                clicked => { root.open-event-uid(cell.date-key, e.uid); }
                                EventChip {
                                    title: e.title;
                                    title-lines: root.title-lines;
                                    time-text: e.time-short;
                                    event-color: e.color;
                                    all-day: e.all-day;
                                    show-time: true;
                                    compact: false;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    horizontal-stretch: 1;
                                }
                            }
                            TouchArea {
                                min-height: 28px;
                                clicked => {
                                    if cell.date-key != "" { root.select-date(cell.date-key); }
                                }
                                Text {
                                    font-family: Theme.font-family;
                                    text: "Open day…";
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                }
                            }
                            Rectangle {
                                height: 1px;
                                background: Theme.stroke;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                }
            }
        }
    }

    // One dim for whichever sheet is in front. Nested sheets reuse it.
    if root.sheet-open && !root.hide-scrim: Rectangle {
        width: 100%;
        height: 100%;
        z: root.sheet-scrim-z;
        background: Theme.dim;
    }

    // Day modal (month/year): all-day block, then timed events, flush and only as tall as their rows.
    if day-modal-open: day-scrim := TouchArea {
        width: 100%;
        height: 100%;
        z: 50;
        clicked => { root.close-day-modal(); }
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 48px);
            clicked => { }
            day-sheet := Rectangle {
                width: 100%;
                max-height: day-scrim.height - 48px;
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.stroke;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: Theme.pad-sm;
                    day-title := Text {
                        font-family: Theme.font-family;
                        text: root.day-modal-title;
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    day-scroll := Flickable {
                        property <length> list-w: min(520px, day-scrim.width - 48px) - Theme.pad * 2;
                        property <length> chrome: day-title.preferred-height + day-actions.preferred-height + Theme.pad * 2 + Theme.pad-sm * 2;
                        property <length> limit: max(0px, day-sheet.max-height - chrome);
                        // Content height until the sheet would leave the screen, then this region scrolls.
                        height: min(day-list.preferred-height, limit);
                        vertical-stretch: 0;
                        content-width: list-w;
                        content-height: day-list.preferred-height;
                        day-list := VerticalLayout {
                            spacing: 0px;
                            width: day-scroll.list-w;
                            if root.modal-has-all-day: VerticalLayout {
                                spacing: 0px;
                                width: day-scroll.list-w;
                                Text {
                                    font-family: Theme.font-family;
                                    text: "All day";
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                    font-weight: 600;
                                    height: self.preferred-height + 4px;
                                    vertical-alignment: top;
                                }
                                for e[ei] in day-events: VerticalLayout {
                                    if e.all-day: DayModalRow {
                                        title: e.title;
                                        calendar: e.calendar;
                                        event-color: e.color;
                                        icon: e.icon;
                                        clicked => { root.open-event(ei); }
                                    }
                                }
                            }
                            if root.modal-has-timed: VerticalLayout {
                                spacing: 0px;
                                width: day-scroll.list-w;
                                for e[ei] in day-events: VerticalLayout {
                                    if !e.all-day: DayModalRow {
                                        title: e.title;
                                        time: e.time;
                                        calendar: e.calendar;
                                        event-color: e.color;
                                        icon: e.icon;
                                        clicked => { root.open-event(ei); }
                                    }
                                }
                            }
                        }
                    }
                    day-actions := HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: end;
                        Button {
                            label: "New event";
                            role: "primary";
                            activate => {
                                if root.selected-date-key != "" {
                                    root.open-create-event(root.selected-date-key, 9 * 60, false);
                                }
                            }
                        }
                        Button {
                            label: "Close";
                            role: "secondary";
                            activate => { root.close-day-modal(); }
                        }
                    }
                }
            }
        }
    }

    // First-run: name the built-in local calendar
    if name-local-open: TouchArea {
        width: 100%;
        height: 100%;
        z: 90;
        clicked => { }
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 48px);
            clicked => { }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                VerticalLayout {
                    padding: Theme.pad-sm;
                    spacing: Theme.pad-sm;
                    Text {
                        font-family: Theme.font-family;
                        text: "Name your local calendar";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    Text {
                        font-family: Theme.font-family;
                        text: "On this device only. Default for new events.";
                        color: Theme.muted;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    Rectangle {
                        height: 40px;
                        background: Theme.bg;
                        border-radius: Theme.radius;
                        border-width: name-input.has-focus ? 2px : 1px;
                        border-color: name-input.has-focus ? Theme.accent : Theme.surface-2;
                        property <int> edit-token: TextEditActions.token;
                        changed edit-token => {
                            if name-input.has-focus {
                                if TextEditActions.action == 1 { name-input.cut(); }
                                if TextEditActions.action == 2 { name-input.copy(); }
                                if TextEditActions.action == 3 { name-input.paste(); }
                                if TextEditActions.action == 4 { name-input.select-all(); }
                            }
                        }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { name-input.focus(); }
                        }
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: Theme.pad-sm;
                            padding-right: Theme.pad-sm;
                            alignment: stretch;
                            name-input := TextInput {
                                font-family: Theme.font-family;
                                text <=> root.name-local-draft;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                single-line: true;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                edited => { root.name-local-set(root.name-local-draft); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: end;
                        Button {
                            label: "Continue";
                            role: "primary";
                            activate => { root.name-local-save(); }
                        }
                    }
                }
            }
        }
    }

    // Create event on local calendar
    if create-event-open: TouchArea {
        width: 100%;
        height: 100%;
        z: 70;
        clicked => { root.close-create-event(); }
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            // Wide enough for date and the two times on one row. Tall enough that
            // the fields fit the 800px window without a scroller.
            width: min(860px, parent.width - 48px);
            height: min(560px, parent.height - 48px);
            clicked => { }
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.surface;
                border-radius: Theme.radius;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: Theme.pad;
                    spacing: Theme.pad-sm;
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: stretch;
                        cross-axis-alignment: center;
                        Text {
                            font-family: Theme.font-family;
                            text: "New event";
                            color: Theme.text;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            horizontal-stretch: 0;
                        }
                        Text {
                            font-family: Theme.font-family;
                            text: root.create-calendar-name + " (Local)";
                            color: Theme.muted;
                            font-size: Theme.font-caption;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                            min-width: 0px;
                        }
                    }
                    Field {
                        caption: "Title";
                        min-width: 0px;
                        text <=> root.create-title;
                        edited => { root.create-set-title(root.create-title); }
                    }
                    HorizontalLayout {
                        spacing: Theme.pad;
                        alignment: stretch;
                        cross-axis-alignment: center;
                        Stepper {
                            horizontal-stretch: 1;
                            caption: "Date";
                            value: root.create-date-label;
                            dec => { root.create-shift-date(-1); }
                            inc => { root.create-shift-date(1); }
                        }
                        TouchArea {
                            horizontal-stretch: 0;
                            min-height: Theme.touch-min;
                            clicked => { root.create-set-all-day(!root.create-all-day); }
                            Rectangle {
                                background: parent.pressed ? Theme.surface-press : transparent;
                                border-radius: Theme.radius;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: start;
                                    cross-axis-alignment: center;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        vertical-stretch: 0;
                                        border-radius: 3px;
                                        border-width: 2px;
                                        border-color: root.create-all-day ? Theme.accent : Theme.muted;
                                        background: root.create-all-day ? Theme.accent : transparent;
                                        if root.create-all-day: FaIcon {
                                            glyph: Icons.check;
                                            size: 12px;
                                            tone: Theme.text-on-accent;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }
                                    Text {
                                        font-family: Theme.font-family;
                                        text: "All day";
                                        color: Theme.text;
                                        font-size: Theme.font-body;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    if !root.create-all-day: HorizontalLayout {
                        spacing: Theme.pad;
                        alignment: stretch;
                        Stepper {
                            horizontal-stretch: 1;
                            caption: "Starts";
                            value: root.create-start-label;
                            dec => { root.create-set-start-mins(root.create-start-mins - 30); }
                            inc => { root.create-set-start-mins(root.create-start-mins + 30); }
                        }
                        Stepper {
                            horizontal-stretch: 1;
                            caption: "Ends";
                            value: root.create-end-label;
                            dec => { root.create-set-end-mins(root.create-end-mins - 30); }
                            inc => { root.create-set-end-mins(root.create-end-mins + 30); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.pad;
                        alignment: stretch;
                        Field {
                            caption: "Location";
                            horizontal-stretch: 1;
                            min-width: 0px;
                            text <=> root.create-location;
                            edited => { root.create-set-location(root.create-location); }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            Text {
                                font-family: Theme.font-family;
                                text: "Repeat";
                                color: Theme.muted;
                                font-size: Theme.font-caption;
                            }
                            TouchArea {
                                clicked => { root.create-open-repeat(); }
                                Rectangle {
                                    min-height: Theme.touch-min;
                                    background: root.create-repeat ? Theme.accent : Theme.surface-2;
                                    border-radius: Theme.radius;
                                    HorizontalLayout {
                                        padding-left: Theme.pad-sm;
                                        padding-right: Theme.pad-sm;
                                        spacing: Theme.pad-sm;
                                        alignment: stretch;
                                        cross-axis-alignment: center;
                                        Text {
                                            font-family: Theme.font-family;
                                            text: root.create-repeat ? root.create-repeat-summary : "Off";
                                            color: root.create-repeat ? Theme.text-on-accent : Theme.text;
                                            font-size: Theme.font-body;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            min-width: 0px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    LongField {
                        caption: "Description";
                        vertical-stretch: 1;
                        min-width: 0px;
                        text <=> root.create-description;
                        edited => { root.create-set-description(root.create-description); }
                    }
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: end;
                        Button {
                            label: "Cancel";
                            role: "secondary";
                            activate => { root.close-create-event(); }
                        }
                        Button {
                            label: "Create";
                            role: "primary";
                            activate => { root.create-save(); }
                        }
                    }
                }
            }
        }
    }

    if create-repeat-open: TouchArea {
        width: 100%;
        height: 100%;
        z: 85;
        clicked => { root.create-close-repeat(); }
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(640px, parent.width - 48px);
            height: min(560px, parent.height - 48px);
            clicked => { }
            Rectangle {
                width: 100%;
                height: 100%;
                background: Theme.surface;
                border-radius: Theme.radius;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: Theme.pad;
                    spacing: Theme.pad-sm;
                    Text {
                        font-family: Theme.font-family;
                        text: "Repeat";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        content-width: self.width;
                        VerticalLayout {
                            spacing: Theme.pad-sm;
                            width: parent.width;
                            HorizontalLayout {
                                spacing: Theme.pad-sm;
                                alignment: stretch;
                                cross-axis-alignment: center;
                                Text {
                                    font-family: Theme.font-family;
                                    text: "Repeat every";
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                }
                                Button {
                                    label: "−";
                                    role: "secondary";
                                    square: true;
                                    activate => { root.create-set-repeat-interval(root.create-repeat-interval - 1); }
                                }
                                Text {
                                    font-family: Theme.font-family;
                                    text: "" + root.create-repeat-interval;
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    font-weight: 700;
                                    min-width: 28px;
                                    horizontal-alignment: center;
                                }
                                Button {
                                    label: "+";
                                    role: "secondary";
                                    square: true;
                                    activate => { root.create-set-repeat-interval(root.create-repeat-interval + 1); }
                                }
                                Dropdown {
                                    horizontal-stretch: 1;
                                    options: root.create-repeat-units;
                                    selected: root.create-repeat-unit;
                                    changed(i) => { root.create-set-repeat-unit(i); }
                                }
                            }
                            if root.create-repeat-unit == 1: Text {
                                font-family: Theme.font-family;
                                text: "On";
                                color: Theme.muted;
                                font-size: Theme.font-caption;
                            }
                            if root.create-repeat-unit == 1: HorizontalLayout {
                                spacing: 2px;
                                alignment: center;
                                for day in root.create-weekdays: DayDot {
                                    letter: day.letter;
                                    on: day.on;
                                    clicked => { root.create-toggle-weekday(day.index); }
                                }
                            }
                            if root.create-repeat-unit == 2: ChoiceRow {
                                label: root.create-month-dom-label;
                                selected: !root.create-by-weekday;
                                clicked => { root.create-set-by-weekday(false); }
                            }
                            if root.create-repeat-unit == 2: ChoiceRow {
                                label: root.create-month-nth-label;
                                selected: root.create-by-weekday;
                                clicked => { root.create-set-by-weekday(true); }
                            }
                            if root.create-repeat-unit == 3: ChoiceRow {
                                label: root.create-quarter-dom-label;
                                selected: !root.create-by-weekday;
                                clicked => { root.create-set-by-weekday(false); }
                            }
                            if root.create-repeat-unit == 3: ChoiceRow {
                                label: root.create-quarter-nth-label;
                                selected: root.create-by-weekday;
                                clicked => { root.create-set-by-weekday(true); }
                            }
                            Text {
                                font-family: Theme.font-family;
                                text: "Ends";
                                color: Theme.muted;
                                font-size: Theme.font-caption;
                            }
                            HorizontalLayout {
                                spacing: Theme.pad-sm;
                                Button {
                                    label: "Never";
                                    role: root.create-repeat-end == 0 ? "primary" : "secondary";
                                    activate => { root.create-set-repeat-end(0); }
                                }
                                Button {
                                    label: "On";
                                    role: root.create-repeat-end == 1 ? "primary" : "secondary";
                                    activate => { root.create-set-repeat-end(1); }
                                }
                                Button {
                                    label: "After";
                                    role: root.create-repeat-end == 2 ? "primary" : "secondary";
                                    activate => { root.create-set-repeat-end(2); }
                                }
                            }
                            if root.create-repeat-end == 1: Stepper {
                                caption: "Ends on";
                                value: root.create-until-label;
                                dec => { root.create-shift-until(-1); }
                                inc => { root.create-shift-until(1); }
                            }
                            if root.create-repeat-end == 2: HorizontalLayout {
                                spacing: Theme.pad-sm;
                                alignment: start;
                                cross-axis-alignment: center;
                                Text {
                                    font-family: Theme.font-family;
                                    text: "Ends after";
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                }
                                Button {
                                    label: "−";
                                    role: "secondary";
                                    square: true;
                                    activate => { root.create-set-repeat-count(root.create-repeat-count - 1); }
                                }
                                Text {
                                    font-family: Theme.font-family;
                                    text: "" + root.create-repeat-count;
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                    font-weight: 700;
                                    min-width: 32px;
                                    horizontal-alignment: center;
                                }
                                Button {
                                    label: "+";
                                    role: "secondary";
                                    square: true;
                                    activate => { root.create-set-repeat-count(root.create-repeat-count + 1); }
                                }
                                Text {
                                    font-family: Theme.font-family;
                                    text: "occurrences";
                                    color: Theme.text;
                                    font-size: Theme.font-body;
                                }
                            }
                            Text {
                                font-family: Theme.font-family;
                                text: root.create-repeat-summary;
                                color: Theme.muted;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        alignment: end;
                        Button {
                            label: "Don't repeat";
                            role: "secondary";
                            activate => { root.create-clear-repeat(); }
                        }
                        Button {
                            label: "Done";
                            role: "primary";
                            activate => { root.create-close-repeat(); }
                        }
                    }
                }
            }
        }
    }

    // Event detail
    if event-detail-open: TouchArea {
        width: 100%;
        height: 100%;
        z: 60;
        clicked => { root.close-event-detail(); }
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(480px, parent.width - 48px);
            height: min(420px, parent.height - 48px);
            clicked => { }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: Theme.pad;
                    Text {
                        font-family: Theme.font-family;
                        text: detail-event.title;
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        font-family: Theme.font-family;
                        text: detail-event.time;
                        color: Theme.muted;
                        font-size: Theme.font-body;
                    }
                    Text {
                        font-family: Theme.font-family;
                        text: detail-event.calendar;
                        color: Theme.muted;
                        font-size: Theme.font-caption;
                    }
                    if detail-event.location != "": Text {
                        font-family: Theme.font-family;
                        text: detail-event.location;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    if detail-event.description != "": Text {
                        font-family: Theme.font-family;
                        text: detail-event.description;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                    }
                    if detail-custom-summary != "": Text {
                        font-family: Theme.font-family;
                        text: detail-custom-summary;
                        color: Theme.muted;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: Theme.pad-sm;
                            Button {
                                label: "Edit";
                                role: "secondary";
                                active: detail-event.writable;
                                activate => { root.open-edit(); }
                            }
                            Button {
                                label: "Customize";
                                role: "primary";
                                activate => { root.open-customize(); }
                            }
                            Button {
                                label: "Close";
                                role: "secondary";
                                activate => { root.close-event-detail(); }
                            }
                        }
                        if !detail-event.writable: Text {
                            font-family: Theme.font-family;
                            text: "Edit is unavailable — this feed is read-only.";
                            color: Theme.muted;
                            font-size: Theme.font-caption;
                        }
                    }
                }
            }
        }
    }

    // Customize sheet
    if customize-open: TouchArea {
        width: 100%;
        height: 100%;
        z: 70;
        clicked => { root.close-customize(); }
        TouchArea {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 48px);
            height: min(640px, parent.height - 48px);
            clicked => { }
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: Theme.pad-sm;
                    Text {
                        font-family: Theme.font-family;
                        text: "Customize";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 700;
                    }
                    if customize-has-recurrence: HorizontalLayout {
                        spacing: Theme.pad-sm;
                        Button {
                            label: "This occurrence";
                            role: customize-occurrence ? "primary" : "secondary";
                            activate => { root.customize-set-occurrence(true); }
                        }
                        Button {
                            label: "All occurrences";
                            role: !customize-occurrence ? "primary" : "secondary";
                            activate => { root.customize-set-occurrence(false); }
                        }
                    }
                    Text { font-family: Theme.font-family; text: "Color"; color: Theme.muted; font-size: Theme.font-caption; }
                    ColorBox {
                        value: root.customize-color;
                        picked(hex) => { root.customize-set-color(hex); }
                    }
                    Text { font-family: Theme.font-family; text: "Icon"; color: Theme.muted; font-size: Theme.font-caption; }
                    HorizontalLayout {
                        spacing: 6px;
                        for ic in ["", "dot", "star", "flag", "bell", "pin"]: TouchArea {
                            min-width: Theme.touch-min;
                            min-height: Theme.touch-min;
                            clicked => { root.customize-set-icon(ic); }
                            Rectangle {
                                background: ic == root.customize-icon ? Theme.accent : Theme.surface-2;
                                border-radius: Theme.radius;
                                EventIcon {
                                    id: ic;
                                    size: Theme.font-body;
                                    tone: ic == root.customize-icon ? Theme.text-on-accent : Theme.text;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        min-width: 0px;
                        // Viewport width, not the text's preferred width. Otherwise every
                        // field grows with its string and the sheet clips them on one edge.
                        content-width: self.width;
                        content-height: fields-col.preferred-height;
                        fields-col := VerticalLayout {
                            spacing: Theme.pad-sm;
                            width: parent.width;
                            min-width: 0px;
                            for f in customize-fields: VerticalLayout {
                                spacing: 4px;
                                width: 100%;
                                min-width: 0px;
                                Text {
                                    font-family: Theme.font-family;
                                    text: f.name;
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                    width: 100%;
                                    min-width: 0px;
                                    wrap: word-wrap;
                                }
                                if f.field-type == 2: Switch {
                                    checked: f.value == "true";
                                    toggled => {
                                        root.customize-set-field(f.id, self.checked ? "true" : "false");
                                    }
                                }
                                if f.field-type == 3: ChoiceDropdown {
                                    value: f.value;
                                    field-id: f.id;
                                    option-count: f.option-count;
                                    has-blank: f.has-blank;
                                    options: root.customize-choices;
                                    picked(id, v) => { root.customize-set-field(id, v); }
                                }
                                if f.field-type == 0 || f.field-type == 1: Rectangle {
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    vertical-stretch: 0;
                                    clip: true;
                                    // Short text is one row. Long text is at least three lines
                                    // and grows so wrapped text is not clipped.
                                    height: f.field-type == 1
                                        ? max(line-h * 3 + 16px, custom-field-input.preferred-height + 16px)
                                        : max(Theme.touch-min, custom-field-input.preferred-height + 16px);
                                    background: Theme.surface-2;
                                    border-radius: Theme.radius;
                                    property <int> edit-token: TextEditActions.token;
                                    changed edit-token => {
                                        if custom-field-input.has-focus {
                                            if TextEditActions.action == 1 { custom-field-input.cut(); }
                                            if TextEditActions.action == 2 { custom-field-input.copy(); }
                                            if TextEditActions.action == 3 { custom-field-input.paste(); }
                                            if TextEditActions.action == 4 { custom-field-input.select-all(); }
                                        }
                                    }
                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        clicked => { custom-field-input.focus(); }
                                    }
                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding: 8px;
                                        alignment: stretch;
                                        custom-field-input := TextInput {
                                            font-family: Theme.font-family;
                                            text: f.value;
                                            color: Theme.text;
                                            font-size: Theme.font-body;
                                            min-width: 0px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            horizontal-alignment: left;
                                            vertical-alignment: f.field-type == 1 ? top : center;
                                            edited => { root.customize-set-field(f.id, self.text); }
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.pad-sm;
                        Button {
                            label: "Save";
                            role: "primary";
                            activate => { root.customize-save(); }
                        }
                        Button {
                            label: "Cancel";
                            role: "secondary";
                            activate => { root.close-customize(); }
                        }
                    }
                }
            }
        }
    }

    if edit-placeholder-open: TouchArea {
        width: 100%;
        height: 100%;
        z: 80;
        clicked => { root.close-edit-placeholder(); }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: 200px;
            background: Theme.surface;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.pad;
                Text {
                    font-family: Theme.font-family;
                    text: "Edit event";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }
                Text {
                    font-family: Theme.font-family;
                    text: "Editing this calendar is not connected yet.";
                    color: Theme.muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                Button {
                    label: "Close";
                    role: "secondary";
                    activate => { root.close-edit-placeholder(); }
                }
            }
        }
    }
}
