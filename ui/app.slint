import { Theme } from "./theme.slint";
import { NavButton } from "./shell/nav.slint";
import { SettingsView, ModuleToggleRow } from "./shell/settings.slint";
import { SetupFlow, SetupModuleRow, FeedRow } from "./setup/setup.slint";
import { ZalenderView, DayCell, AgendaItem } from "./modules/zalender/views.slint";

export { ModuleToggleRow, SetupModuleRow, FeedRow, DayCell, AgendaItem }

export component AppWindow inherits Window {
    title: "Wijitify";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: "Segoe UI";

    // 0 setup, 1 home, 2 settings
    in-out property <int> screen: 0;
    in-out property <string> active-module: "zalender";
    in property <string> clock-text: "";
    in property <string> perf-overlay: "";

    // setup
    in-out property <int> setup-step: 0;
    in property <[SetupModuleRow]> setup-modules;
    in-out property <string> zalender-timezone: "America/New_York";
    in-out property <[FeedRow]> zalender-feeds;
    in-out property <string> new-feed-name: "";
    in-out property <string> new-feed-url: "";
    in-out property <string> new-feed-color: "#3b82f6";
    in property <bool> show-zalender-setup: true;

    // settings
    in property <[ModuleToggleRow]> settings-modules;
    in property <string> current-version: "";
    in property <int> update-status: 0;
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <int> update-percent: 0;
    in property <string> update-error: "";
    in property <string> update-checked: "";
    in property <string> settings-label: "Settings";

    // zalender
    in property <string> zal-title-month: "";
    in property <string> zal-status: "";
    in property <bool> zal-refreshing: false;
    in property <[DayCell]> zal-days;
    in property <[AgendaItem]> zal-agenda;
    in property <string> zal-agenda-date: "";
    in property <bool> zal-empty-feeds: false;

    callback setup-toggle-module(int);
    callback setup-add-feed();
    callback setup-remove-feed(int);
    callback setup-next();
    callback setup-back();
    callback setup-finish();

    callback open-settings();
    callback close-settings();
    callback settings-toggle-module(int);
    callback run-setup-again();
    callback quit-app();
    callback check-updates();
    callback start-update();
    callback restart-app();

    callback zal-prev-month();
    callback zal-next-month();
    callback zal-go-today();
    callback zal-select-day(int);
    callback zal-refresh();

    // Hidden corner long-press exit (maintenance)
    property <bool> corner-held: false;

    VerticalLayout {
        if screen == 0: SetupFlow {
            step <=> root.setup-step;
            modules: root.setup-modules;
            zalender-timezone <=> root.zalender-timezone;
            zalender-feeds <=> root.zalender-feeds;
            new-feed-name <=> root.new-feed-name;
            new-feed-url <=> root.new-feed-url;
            new-feed-color <=> root.new-feed-color;
            show-zalender-page: root.show-zalender-setup;
            toggle-module(i) => { root.setup-toggle-module(i); }
            add-feed => { root.setup-add-feed(); }
            remove-feed(i) => { root.setup-remove-feed(i); }
            next => { root.setup-next(); }
            back => { root.setup-back(); }
            finish-setup => { root.setup-finish(); }
        }

        if screen == 1: VerticalLayout {
            Rectangle {
                background: Theme.surface;
                min-height: Theme.touch-min;
                max-height: Theme.touch-min;

                HorizontalLayout {
                    padding: Theme.pad-sm;
                    spacing: Theme.pad-sm;

                    Text {
                        text: "Wijitify";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.clock-text;
                        color: Theme.muted;
                        font-size: 16px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                    }
                    NavButton { label: root.settings-label; activate => { root.open-settings(); } }
                }
            }

            if active-module == "zalender": ZalenderView {
                title-month: root.zal-title-month;
                status-text: root.zal-status;
                refreshing: root.zal-refreshing;
                days: root.zal-days;
                agenda: root.zal-agenda;
                agenda-date: root.zal-agenda-date;
                empty-feeds: root.zal-empty-feeds;
                prev-month => { root.zal-prev-month(); }
                next-month => { root.zal-next-month(); }
                go-today => { root.zal-go-today(); }
                select-day(i) => { root.zal-select-day(i); }
                open-settings => { root.open-settings(); }
                refresh => { root.zal-refresh(); }
            }

            if active-module != "zalender": Rectangle {
                background: Theme.bg;
                Text {
                    text: "No module enabled";
                    color: Theme.muted;
                    font-size: 20px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        if screen == 2: SettingsView {
            modules: root.settings-modules;
            perf-overlay: root.perf-overlay;
            current-version: root.current-version;
            update-status: root.update-status;
            update-version: root.update-version;
            update-notes: root.update-notes;
            update-percent: root.update-percent;
            update-error: root.update-error;
            update-checked: root.update-checked;
            toggle-module(i) => { root.settings-toggle-module(i); }
            run-setup-again => { root.run-setup-again(); }
            quit-app => { root.quit-app(); }
            close-settings => { root.close-settings(); }
            check-updates => { root.check-updates(); }
            start-update => { root.start-update(); }
            restart-app => { root.restart-app(); }
        }
    }

    // Top-left maintenance exit: hold ~1.5s equivalent via repeated presses in settings;
    // also a small invisible corner that opens settings then quit.
    TouchArea {
        x: 0; y: 0; width: 24px; height: 24px;
        clicked => { root.open-settings(); }
    }
}
