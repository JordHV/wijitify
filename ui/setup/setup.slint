import { Theme } from "../theme.slint";
import { Button, Field, Row, Banner } from "../shell/kit.slint";

export struct SetupModuleRow {
    id: string,
    name: string,
    description: string,
    selected: bool,
}

export struct FeedRow {
    name: string,
    url: string,
    color: color,
}

export component SetupFlow inherits Rectangle {
    background: Theme.bg;

    in-out property <int> step: 0;
    in property <[SetupModuleRow]> modules;
    in-out property <string> zalender-timezone: "America/New_York";
    in-out property <[FeedRow]> zalender-feeds;
    in-out property <string> new-feed-name: "";
    in-out property <string> new-feed-url: "";
    in-out property <string> new-feed-color: "#3b82f6";
    in property <bool> show-zalender-page: true;
    in property <string> banner-message: "";
    in property <int> banner-kind: 0;

    callback toggle-module(int);
    callback add-feed();
    callback remove-feed(int);
    callback finish-setup();
    callback back();
    callback next();

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.pad;

        Text {
            font-family: Theme.font-family;
            text: step == 0 ? "Choose modules" : "Zalender setup";
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: 700;
        }

        if step == 0: VerticalLayout {
            spacing: Theme.pad-sm;
            for m[i] in modules: Row {
                title: m.name;
                caption: m.description;
                mark: "check";
                checked: m.selected;
                activate => { root.toggle-module(i); }
            }
        }

        if step == 1 && show-zalender-page: VerticalLayout {
            spacing: Theme.pad-sm;
            Field {
                caption: "Timezone";
                text <=> root.zalender-timezone;
            }
            Text {
                font-family: Theme.font-family;
                text: "Calendar feeds";
                color: Theme.muted;
                font-size: Theme.font-caption;
            }
            for f[fi] in zalender-feeds: HorizontalLayout {
                spacing: Theme.pad-sm;
                Row {
                    horizontal-stretch: 1;
                    title: f.name;
                    caption: f.url;
                    mark: "color";
                    mark-color: f.color;
                }
                Button {
                    label: "Remove";
                    role: "danger";
                    activate => { root.remove-feed(fi); }
                }
            }
            Field {
                caption: "Name";
                text <=> root.new-feed-name;
            }
            Field {
                caption: "ICS URL";
                text <=> root.new-feed-url;
            }
            Banner {
                message: root.banner-message;
                kind: root.banner-kind;
            }
            Button {
                label: "Add feed";
                role: "secondary";
                activate => { root.add-feed(); }
            }
        }

        HorizontalLayout {
            spacing: Theme.pad;
            alignment: end;
            if step > 0: Button {
                label: "Back";
                role: "secondary";
                activate => { root.back(); }
            }
            Button {
                label: step == 0 ? "Next" : "Finish";
                role: "primary";
                activate => {
                    if step == 0 { root.next(); } else { root.finish-setup(); }
                }
            }
        }
    }
}
